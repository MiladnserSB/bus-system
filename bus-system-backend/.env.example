NODE_ENV=development
PORT=3000

# PostgreSQL & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bus_system?schema=public
REDIS_URL=redis://localhost:6379

# JWT & Cryptographic Secrets (replace with strong 32+ char secrets in production)
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
OTP_HMAC_SECRET=change-me-otp-hmac-secret-minimum-32-characters
QR_HMAC_SECRET=change-me-qr-hmac-secret-minimum-32-characters

# CORS & Rate Limiting
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
RATE_LIMIT_GLOBAL_TTL_MS=60000
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_BOOKING_MAX=30
RATE_LIMIT_OTP_HOURLY_MAX=5

# Initial Admin Seed (dev/initial setup)
ADMIN_SEED_NAME=المدير العام
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@masar-bus.sy
ADMIN_SEED_PHONE=+963900000001
ADMIN_SEED_PASSWORD=Admin@123456

# SMS Provider (TBD-5: log | http)
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=MASAR

# Firebase Cloud Messaging HTTP v1
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Backup Configuration (REQ-AUTO-04, SEC-11)
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=change-me-backup-aes-256-key-32-chars
BACKUP_RETENTION_DAYS=30
BACKUP_PG_DUMP_PATH=pg_dump

# Timezone
TZ=Asia/Damascus
